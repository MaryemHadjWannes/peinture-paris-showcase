# Copy this file to .env for local development and fill in the values.
# NEVER commit .env. In production, set these variables in the hosting
# dashboard (e.g. Render > Environment), not in the repository.

# --- Server (required, the server refuses to start without them) ---
JWT_SECRET=
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public URL of the site, e.g. https://hn-renovation.fr (used for CORS)
CORS_ORIGIN=

# --- Cloudflare R2 (required, photo gallery storage) ---
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
# Public bucket URL, e.g. https://pub-xxxxxxxx.r2.dev (no trailing slash)
R2_PUBLIC_DOMAIN=

# --- Optional ---
# Google Places API key for /api/reviews
GOOGLE_API_KEY=
# Port (Render/Docker set it automatically)
PORT=5000

# --- Frontend (build time, optional) ---
# Base URL of the API for the admin page. Leave empty in production
# (same origin). Defaults to http://localhost:5000 in `npm run dev`.
VITE_API_BASE=

# --- Only for the one-off migrate.ts script (Cloudinary) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
